// ZenHR Multi-Tenant HRMS — Prisma Schema
// Covers all entities for all 7 phases
// Generated: 2026-10-26

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  SUPER_ADMIN
  OPERATION_MANAGER
  COMPANY_ADMIN
  HR_MANAGER
  DEPARTMENT_MANAGER
  TEAM_LEAD
  EMPLOYEE
}

enum DataScope {
  PLATFORM
  COMPANY
  DEPARTMENT
  TEAM
  SELF
}

enum SubscriptionTier {
  BASIC
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  TRIALING
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum EmployeeStatus {
  ACTIVE
  ON_PROBATION
  SUSPENDED
  ON_LEAVE
  RESIGNED
  TERMINATED
}

enum AttendanceStatus {
  PRESENT
  PRESENT_REMOTE
  ABSENT
  ABSENT_PENDING_REVIEW
  ON_LEAVE
  HOLIDAY
  WEEKEND
}

enum LeaveType {
  CASUAL
  SICK
  ANNUAL
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  WITHDRAWN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

enum RemoteWorkStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
  EXPIRED
}

enum ResourceRequestStatus {
  PENDING
  STEP_1_APPROVED
  STEP_2_APPROVED
  FULFILLED
  REJECTED
  CANCELLED
}

enum NotificationType {
  LEAVE_SUBMITTED
  LEAVE_APPROVED
  LEAVE_REJECTED
  ATTENDANCE_EXCEPTION
  BREAK_ALERT
  PAYSLIP_GENERATED
  STATUS_CHANGED
  SUPPORT_MODE_ENTERED
  SUBSCRIPTION_EXPIRING
  SUBSCRIPTION_SUSPENDED
  GENERAL
}

enum TimerStatus {
  RUNNING
  PAUSED
  STOPPED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  LOGIN_FAILED
  SUPPORT_MODE_ENTER
  SUPPORT_MODE_EXIT
  SUPPORT_MODE_ACTION
  PASSWORD_RESET
  EMAIL_VERIFIED
  TWO_FA_ENABLED
  TWO_FA_DISABLED
  PAYROLL_RUN
  BULK_IMPORT
  STATUS_CHANGE
  SUSPENSION
  REACTIVATION
}

// ============================================================
// PLATFORM-LEVEL MODELS (no companyId — bypass tenant filter)
// ============================================================

model Company {
  id               String             @id @default(cuid())
  name             String
  slug             String             @unique
  email            String             @unique
  phone            String?
  address          String?
  logoUrl          String?
  website          String?
  industry         String?
  size             String?
  status           CompanyStatus      @default(ACTIVE)
  timezone         String             @default("UTC")
  locale           String             @default("en")
  subscriptionTier SubscriptionTier   @default(BASIC)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deletedAt        DateTime?

  // Relations
  users               User[]
  departments         Department[]
  designations        Designation[]
  teams               Team[]
  employees           Employee[]
  attendanceRecords   AttendanceRecord[]
  workTimerEntries    WorkTimerEntry[]
  remoteWorkPermissions RemoteWorkPermission[]
  leaveTypes          LeaveTypeSetting[]
  leaveRequests       LeaveRequest[]
  leaveBalances       LeaveBalance[]
  payrollStructures   PayrollStructure[]
  payslips            Payslip[]
  resourceRequests    ResourceRequest[]
  subscriptions       Subscription[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  supportModeSessions SupportModeSession[]
  ipWhitelist         IpWhitelist[]
  shifts              Shift[]

  @@map("companies")
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  passwordHash          String
  role                  UserRole
  dataScope             DataScope
  isEmailVerified       Boolean   @default(false)
  emailVerifyToken      String?
  emailVerifyExpiry     DateTime?
  passwordResetToken    String?
  passwordResetExpiry   DateTime?
  refreshTokenHash      String?
  failedLoginAttempts   Int       @default(0)
  lockedUntil           DateTime?
  lastLoginAt           DateTime?
  lastLoginIp           String?
  lastLoginUserAgent    String?
  lastLoginCity         String?
  lastLoginCountry      String?
  twoFaEnabled          Boolean   @default(false)
  twoFaSecret           String?
  twoFaBackupCodes      String[]  @default([])
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  // Platform user (SUPER_ADMIN, OPERATION_MANAGER) — no companyId
  companyId             String?
  company               Company?  @relation(fields: [companyId], references: [id])

  // Relations
  employee              Employee?
  auditLogs             AuditLog[]
  supportModeSessions   SupportModeSession[]
  notifications         Notification[]

  @@index([companyId])
  @@index([email])
  @@map("users")
}

// ============================================================
// TENANT-SCOPED MODELS (all have companyId)
// ============================================================

model Department {
  id          String    @id @default(cuid())
  companyId   String
  name        String
  description String?
  managerId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees   Employee[]
  teams       Team[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("departments")
}

model Designation {
  id          String    @id @default(cuid())
  companyId   String
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees   Employee[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("designations")
}

model Team {
  id           String    @id @default(cuid())
  companyId    String
  departmentId String
  name         String
  description  String?
  leadId       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id])
  employees    Employee[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([departmentId])
  @@map("teams")
}

model Employee {
  id                  String         @id @default(cuid())
  companyId           String
  userId              String         @unique
  employeeCode        String
  firstName           String
  lastName            String
  phone               String?
  dateOfBirth         DateTime?
  gender              String?
  nationality         String?
  address             String?
  city                String?
  country             String?
  profilePictureUrl   String?
  hireDate            DateTime
  probationEndDate    DateTime?
  status              EmployeeStatus @default(ACTIVE)
  departmentId        String?
  designationId       String?
  teamId              String?
  reportingManagerId  String?
  baseSalary          Decimal?       @db.Decimal(12, 2)
  bankAccountNumber   String?
  bankName            String?
  bankBranch          String?
  nidNumber           String?
  taxId               String?
  locationConsent     Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  deletedAt           DateTime?

  // Relations
  company             Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user                User           @relation(fields: [userId], references: [id])
  department          Department?    @relation(fields: [departmentId], references: [id])
  designation         Designation?   @relation(fields: [designationId], references: [id])
  team                Team?          @relation(fields: [teamId], references: [id])
  reportingManager    Employee?      @relation("ReportingLine", fields: [reportingManagerId], references: [id])
  subordinates        Employee[]     @relation("ReportingLine")
  emergencyContacts   EmergencyContact[]
  documents           EmployeeDocument[]
  educations          EmployeeEducation[]
  experiences         EmployeeExperience[]
  skills              EmployeeSkill[]
  attendanceRecords   AttendanceRecord[]
  workTimerEntries    WorkTimerEntry[]
  remoteWorkPermissions RemoteWorkPermission[]
  leaveRequests       LeaveRequest[]
  leaveBalances       LeaveBalance[]
  payslips            Payslip[]
  resourceRequests    ResourceRequest[]
  shifts              EmployeeShift[]

  @@unique([companyId, employeeCode])
  @@index([companyId])
  @@index([departmentId])
  @@index([teamId])
  @@index([reportingManagerId])
  @@map("employees")
}

model EmergencyContact {
  id           String   @id @default(cuid())
  employeeId   String
  name         String
  relationship String
  phone        String
  email        String?
  address      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("emergency_contacts")
}

model EmployeeDocument {
  id          String   @id @default(cuid())
  employeeId  String
  companyId   String
  name        String
  type        String
  fileUrl     String
  uploadedAt  DateTime @default(now())

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("employee_documents")
}

model EmployeeEducation {
  id           String    @id @default(cuid())
  employeeId   String
  institution  String
  degree       String
  field        String?
  startDate    DateTime
  endDate      DateTime?
  grade        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_educations")
}

model EmployeeExperience {
  id          String    @id @default(cuid())
  employeeId  String
  company     String
  position    String
  startDate   DateTime
  endDate     DateTime?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_experiences")
}

model EmployeeSkill {
  id         String   @id @default(cuid())
  employeeId String
  skill      String
  level      String?
  createdAt  DateTime @default(now())

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_skills")
}

// ============================================================
// ATTENDANCE & WORK TIMER
// ============================================================

model Shift {
  id             String          @id @default(cuid())
  companyId      String
  name           String
  startTime      String          // HH:mm
  endTime        String          // HH:mm
  breakDuration  Int             @default(60) // minutes
  workDays       Int[]           // 1=Mon, 7=Sun
  isDefault      Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeShifts EmployeeShift[]

  @@index([companyId])
  @@map("shifts")
}

model EmployeeShift {
  id          String   @id @default(cuid())
  employeeId  String
  shiftId     String
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt   DateTime @default(now())

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift       Shift    @relation(fields: [shiftId], references: [id])

  @@map("employee_shifts")
}

model AttendanceRecord {
  id              String           @id @default(cuid())
  companyId       String
  employeeId      String
  date            DateTime         @db.Date
  checkInTime     DateTime?
  checkOutTime    DateTime?
  status          AttendanceStatus @default(ABSENT)
  checkInLocation String?          // JSON string with lat/lng (optional consent)
  checkInIp       String?
  isRemote        Boolean          @default(false)
  overtimeMinutes Int              @default(0)
  workMinutes     Int              @default(0)
  notes           String?
  markedBySystem  Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee        Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([companyId, employeeId, date])
  @@index([companyId])
  @@index([employeeId])
  @@index([date])
  @@map("attendance_records")
}

model WorkTimerEntry {
  id             String      @id @default(cuid())
  companyId      String
  employeeId     String
  date           DateTime    @db.Date
  startedAt      DateTime
  stoppedAt      DateTime?
  totalMinutes   Int         @default(0)
  status         TimerStatus @default(RUNNING)
  breaks         TimerBreak[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  company        Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee       Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([employeeId])
  @@index([date])
  @@map("work_timer_entries")
}

model TimerBreak {
  id           String         @id @default(cuid())
  timerId      String
  startedAt    DateTime
  endedAt      DateTime?
  durationMin  Int?

  timer        WorkTimerEntry @relation(fields: [timerId], references: [id], onDelete: Cascade)

  @@map("timer_breaks")
}

model RemoteWorkPermission {
  id           String           @id @default(cuid())
  companyId    String
  employeeId   String
  reason       String
  startDate    DateTime         @db.Date
  endDate      DateTime         @db.Date
  status       RemoteWorkStatus @default(PENDING)
  step1ApproverId String?
  step1ApprovedAt DateTime?
  step2ApproverId String?
  step2ApprovedAt DateTime?
  rejectionReason String?
  revokedAt    DateTime?
  revokedById  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee     Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([employeeId])
  @@map("remote_work_permissions")
}

model IpWhitelist {
  id          String   @id @default(cuid())
  companyId   String
  ipAddress   String
  description String?
  addedById   String
  createdAt   DateTime @default(now())

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, ipAddress])
  @@index([companyId])
  @@map("ip_whitelist")
}

// ============================================================
// LEAVE MANAGEMENT
// ============================================================

model LeaveTypeSetting {
  id                      String    @id @default(cuid())
  companyId               String
  leaveType               LeaveType
  annualAllocation        Int       @default(0)
  requiresReason          Boolean   @default(true)
  requiresMedicalCert     Boolean   @default(false)
  isActive                Boolean   @default(true)
  carryForwardDays        Int       @default(0)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  company                 Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leaveRequests           LeaveRequest[]

  @@unique([companyId, leaveType])
  @@index([companyId])
  @@map("leave_type_settings")
}

model LeaveRequest {
  id                 String      @id @default(cuid())
  companyId          String
  employeeId         String
  leaveTypeSettingId String
  startDate          DateTime    @db.Date
  endDate            DateTime    @db.Date
  totalDays          Int
  reason             String?
  medicalCertUrl     String?
  status             LeaveStatus @default(PENDING)
  step1ApproverId    String?
  step1Status        ApprovalStatus @default(PENDING)
  step1ApprovedAt    DateTime?
  step1Notes         String?
  step2ApproverId    String?
  step2Status        ApprovalStatus @default(PENDING)
  step2ApprovedAt    DateTime?
  step2Notes         String?
  finalApproverId    String?
  finalStatus        ApprovalStatus @default(PENDING)
  finalApprovedAt    DateTime?
  finalNotes         String?
  cancelledAt        DateTime?
  cancelledById      String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  company            Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee           Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeSetting   LeaveTypeSetting @relation(fields: [leaveTypeSettingId], references: [id])

  @@index([companyId])
  @@index([employeeId])
  @@index([status])
  @@map("leave_requests")
}

model LeaveBalance {
  id          String    @id @default(cuid())
  companyId   String
  employeeId  String
  leaveType   LeaveType
  year        Int
  allocated   Int       @default(0)
  used        Int       @default(0)
  pending     Int       @default(0)
  carried     Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([companyId, employeeId, leaveType, year])
  @@index([companyId])
  @@index([employeeId])
  @@map("leave_balances")
}

// ============================================================
// RESOURCE REQUESTS
// ============================================================

model ResourceRequest {
  id               String                @id @default(cuid())
  companyId        String
  requestedById    String
  resourceType     String
  description      String
  justification    String?
  status           ResourceRequestStatus @default(PENDING)
  step1ApproverId  String?
  step1Status      ApprovalStatus        @default(PENDING)
  step1ApprovedAt  DateTime?
  step1Notes       String?
  step2ApproverId  String?
  step2Status      ApprovalStatus        @default(PENDING)
  step2ApprovedAt  DateTime?
  step2Notes       String?
  step3FulfilledAt DateTime?
  step3FulfilledBy String?
  step3Notes       String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requestedBy      Employee @relation(fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([requestedById])
  @@map("resource_requests")
}

// ============================================================
// PAYROLL
// ============================================================

model PayrollStructure {
  id              String    @id @default(cuid())
  companyId       String
  name            String
  baseSalary      Decimal   @db.Decimal(12, 2)
  components      Json      // Array of {type, name, value, isPercentage}
  taxRules        Json?     // Tax calculation rules
  isDefault       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payslips        Payslip[]

  @@index([companyId])
  @@map("payroll_structures")
}

model Payslip {
  id                String           @id @default(cuid())
  companyId         String
  employeeId        String
  payrollStructureId String?
  month             Int              // 1-12
  year              Int
  baseSalary        Decimal          @db.Decimal(12, 2)
  allowances        Decimal          @db.Decimal(12, 2) @default(0)
  bonuses           Decimal          @db.Decimal(12, 2) @default(0)
  deductions        Decimal          @db.Decimal(12, 2) @default(0)
  taxAmount         Decimal          @db.Decimal(12, 2) @default(0)
  netSalary         Decimal          @db.Decimal(12, 2)
  breakdown         Json?            // Detailed component breakdown
  pdfUrl            String?
  generatedAt       DateTime?
  generatedById     String?
  status            String           @default("DRAFT") // DRAFT, GENERATED, PAID
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  company           Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee          Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrollStructure  PayrollStructure? @relation(fields: [payrollStructureId], references: [id])

  @@unique([companyId, employeeId, month, year])
  @@index([companyId])
  @@index([employeeId])
  @@map("payslips")
}

// ============================================================
// SUBSCRIPTIONS & BILLING
// ============================================================

model Subscription {
  id                    String             @id @default(cuid())
  companyId             String             @unique
  tier                  SubscriptionTier   @default(BASIC)
  status                SubscriptionStatus @default(TRIALING)
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  stripePriceId         String?
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  trialEnd              DateTime?
  cancelAtPeriodEnd     Boolean            @default(false)
  failedPaymentCount    Int                @default(0)
  lastFailedPaymentAt   DateTime?
  lastFailedReason      String?
  suspendedAt           DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  company               Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([stripeCustomerId])
  @@map("subscriptions")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id         String           @id @default(cuid())
  companyId  String?
  userId     String
  type       NotificationType
  title      String
  body       String
  data       Json?
  isRead     Boolean          @default(false)
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  company    Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
  @@index([isRead])
  @@map("notifications")
}

// ============================================================
// AUDIT LOG & SUPPORT MODE
// ============================================================

model AuditLog {
  id              String      @id @default(cuid())
  companyId       String?
  userId          String?
  action          AuditAction
  entity          String?     // Table/model name
  entityId        String?
  oldValues       Json?
  newValues       Json?
  ipAddress       String?
  userAgent       String?
  isSupportMode   Boolean     @default(false)
  supportSessionId String?
  createdAt       DateTime    @default(now())

  user            User?       @relation(fields: [userId], references: [id])
  company         Company?    @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model SupportModeSession {
  id           String    @id @default(cuid())
  superAdminId String
  companyId    String
  reason       String
  startedAt    DateTime  @default(now())
  expiresAt    DateTime
  endedAt      DateTime?
  isActive     Boolean   @default(true)

  superAdmin   User      @relation(fields: [superAdminId], references: [id])
  company      Company   @relation(fields: [companyId], references: [id])

  @@index([superAdminId])
  @@index([companyId])
  @@map("support_mode_sessions")
}
