# Backend Environment Variables
# Copy this file to .env and fill in the values

# ============================================================
# Application
# ============================================================
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
# Optional comma-separated IP addresses or CIDRs of verified ingress proxies.
TRUSTED_PROXY_CIDRS=

# ============================================================
# Database (PostgreSQL)
# ============================================================
DATABASE_URL="postgresql://zenhr:zenhr_secret@localhost:5432/zenhr_db?schema=public"

# ============================================================
# JWT Authentication
# ============================================================
# Configure two independent secrets for production. Blank development keys are process-local.
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
# Required in production and for authenticator setup. Generate a stable 32-byte base64 key.
TOTP_ENCRYPTION_KEY=

# ============================================================
# Cookie Configuration
# ============================================================
COOKIE_SECRET=your-cookie-secret-change-in-production

# ============================================================
# Redis (for BullMQ & Socket.IO)
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=zenhr_redis_secret

# ============================================================
# Email (Nodemailer)
# ============================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM_NAME=ZenHR
MAIL_FROM_ADDRESS=noreply@zenhr.com

# ============================================================
# Frontend URL (for CORS & email links)
# ============================================================
FRONTEND_URL=http://localhost:3000

# ============================================================
# Cloudinary (File Storage)
# ============================================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ============================================================
# Stripe (Billing)
# ============================================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_BASIC_PRICE_ID=price_basic_plan_id
STRIPE_PREMIUM_PRICE_ID=price_premium_plan_id

# ============================================================
# Google Gemini AI
# ============================================================
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash

# ============================================================
# Initial platform administrator provisioning command
# ============================================================
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
