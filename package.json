{
  "name": "zenhr",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/frontend",
    "apps/backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "dev:backend": "npm run start:dev --workspace=apps/backend",
    "build:frontend": "npm run build --workspace=apps/frontend",
    "build:backend": "npm run build --workspace=apps/backend",
    "build": "npm run build:backend && npm run build:frontend",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate --workspace=apps/backend",
    "prisma:migrate": "npm run prisma:migrate --workspace=apps/backend",
    "prisma:studio": "npm run prisma:studio --workspace=apps/backend",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "test:backend": "npm --prefix apps/backend test",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "multer": "2.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "docx": "^9.15.0",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "multer": "$multer",
    "body-parser@1": "1.20.9",
    "express@4": { "qs": "6.17.1" },
    "@nestjs/common@10": { "file-type": "21.3.4" },
    "@nestjs/schedule@4": { "uuid": "11.1.1" },
    "bull@4": { "uuid": "11.1.1" },
    "js-yaml@4": "4.3.2",
    "lodash@4": "4.18.1",
    "next": { "postcss": "8.5.32" }
  },
  "engines": {
    "node": "24.x",
    "npm": ">=10.0.0"
  }
}
